# ─── Aplicação ────────────────────────────────────────────────────────────────
ENVIRONMENT=development
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:5173

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-isto-em-producao

# ─── Banco / fila ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://hunterai:hunterai@localhost:5432/hunterai
REDIS_URL=redis://localhost:6379/0

# ─── Claude (motor de reescrita) ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Modelo dos planos pagos
HUMANIZE_MODEL=claude-sonnet-5
# Modelo do plano gratuito (mais barato)
HUMANIZE_MODEL_FREE=claude-haiku-4-5

# ─── Detector ─────────────────────────────────────────────────────────────────
# Modelo causal usado para perplexidade. Deixe vazio para rodar só as
# heurísticas estatísticas (sem torch/transformers instalados).
DETECTOR_MODEL=pierreguillou/gpt2-small-portuguese

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...

# ─── Armazenamento de arquivos ────────────────────────────────────────────────
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10
